<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe e nao Exe: o agente vive na bandeja e abre a janela do scanner.
         Console apareceria atras de cada digitalizacao. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cartorio360Agente</AssemblyName>
    <RootNamespace>Cartorio360.Agente</RootNamespace>
    <Version>2.0.0</Version>

    <!-- NU1701: o NTwain publica destino net6.0-windows, que serve para net8.0,
         mas o NuGet ainda alerta por causa dos destinos .NET Framework do pacote. -->
    <NoWarn>NU1701</NoWarn>

    <!-- Icone do executavel (Explorer, barra de tarefas, Aplicativos instalados).
         Gerado a partir de Cartorio360-front\public\cartorio_icon.png por
         tools\gerar-icone.ps1 - ver README. -->
    <ApplicationIcon>cartorio_icon.ico</ApplicationIcon>

    <!-- Metadados que aparecem nas propriedades do arquivo. Sem isto o .exe fica
         sem identificacao, o que pesa contra em heuristica de antivirus. -->
    <Product>Agente 360</Product>
    <Company>Cartorio 360</Company>
    <AssemblyTitle>Agente 360</AssemblyTitle>
    <Description>Scanner, upload de documentos digitalizados e impressao de etiquetas de selo.</Description>
    <Copyright>(c) Cartorio 360</Copyright>

    <!-- x86, e nao x64, por causa do TWAIN.
         Muitos data sources TWAIN sao de 32 bits, e um processo de 64 bits nao os
         carrega. Medido nesta bancada: em x64 so a Canon aparece; em x86 aparecem
         a Canon E a EPSON L355/L358. O que antes obrigava x64 era o SDK NITGEN, e
         a biometria saiu do escopo — Kestrel, spooler, WIA e PdfSharpCore sao
         indiferentes a arquitetura.
         Self-contained + single file para o instalador nao depender de runtime
         instalado na estacao. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- COM interop (WIA) nao sobrevive a trimagem. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Kestrel a partir de um projeto WinForms. Usar FrameworkReference em vez do
       Sdk.Web evita o conflito entre os alvos de Web e de WindowsForms. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- TWAIN: caminho principal de aquisicao quando o atendente pede duplex.
         O WIA nao serve para isso — ver Scanner\TwainAquisicao.cs. -->
    <PackageReference Include="NTwain" Version="3.7.6" />
    <PackageReference Include="PdfSharpCore" Version="1.3.28" />
  </ItemGroup>

  <!-- Icone embutido como recurso: a bandeja e as janelas carregam da memoria, sem
       depender de arquivo ao lado do exe (o publish e single-file). LogicalName
       fixo para o nome nao mudar junto com o namespace. -->
  <ItemGroup>
    <EmbeddedResource Include="cartorio_icon.ico" LogicalName="cartorio_icon.ico" />
  </ItemGroup>

  <!-- Interop do WIA.
       O WiaMultiPageScan original usava <COMReference>, que exige a task
       ResolveComReference - disponivel apenas no MSBuild do .NET Framework (o do
       Visual Studio). Com ele, `dotnet build` falha com MSB4803 e o projeto so
       compila numa maquina com VS instalado, ruim para o pipeline do instalador.
       Aqui o interop e pre-gerado uma vez (lib/Interop.WIA.dll, via TlbImp sobre
       C:\Windows\System32\wiaaut.dll) e referenciado como assembly comum.
       EmbedInteropTypes=true embute os tipos usados, entao a DLL nao precisa ser
       distribuida e nao ha referencia a mscorlib do .NET Framework em runtime.
       Para regerar: ver exeScanner\README.md -->
  <ItemGroup>
    <Reference Include="Interop.WIA">
      <HintPath>..\lib\Interop.WIA.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
